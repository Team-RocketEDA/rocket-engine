# top_mixed.sdc — TIMING-STA M11 fixture: top-level boundary constraints.
#
# 20 ns clock plus input/output delays, transitions, and loads on the
# digital boundary. Deliberate gaps (must surface as unconstrained
# findings, never assumed): rdata0_in, rdata1_in carry no input
# delay; wdata0_out, wdata1_out carry no output delay; the analog
# pins (adc_trig_in, dac_data_out, adc_ready_out) carry neither.
# Bus bits are expanded explicitly (no wildcards) for sta safety.

create_clock -name clk -period 20.0 [get_ports clk_in]
set_clock_uncertainty 0.2 [get_clocks clk]
set_clock_transition 0.3 [get_clocks clk]

set_input_delay -clock clk -max 2.0 [get_ports {
  rst_in timer_irq_in rf_ready_in ibus_ack_in dbus_ack_in ext_ready_in
  ibus_rdt_in[0] ibus_rdt_in[1] ibus_rdt_in[2] ibus_rdt_in[3]
  ibus_rdt_in[4] ibus_rdt_in[5] ibus_rdt_in[6] ibus_rdt_in[7]
  ibus_rdt_in[8] ibus_rdt_in[9] ibus_rdt_in[10] ibus_rdt_in[11]
  ibus_rdt_in[12] ibus_rdt_in[13] ibus_rdt_in[14] ibus_rdt_in[15]
  ibus_rdt_in[16] ibus_rdt_in[17] ibus_rdt_in[18] ibus_rdt_in[19]
  ibus_rdt_in[20] ibus_rdt_in[21] ibus_rdt_in[22] ibus_rdt_in[23]
  ibus_rdt_in[24] ibus_rdt_in[25] ibus_rdt_in[26] ibus_rdt_in[27]
  ibus_rdt_in[28] ibus_rdt_in[29] ibus_rdt_in[30] ibus_rdt_in[31]
  dbus_rdt_in[0] dbus_rdt_in[1] dbus_rdt_in[2] dbus_rdt_in[3]
  dbus_rdt_in[4] dbus_rdt_in[5] dbus_rdt_in[6] dbus_rdt_in[7]
  dbus_rdt_in[8] dbus_rdt_in[9] dbus_rdt_in[10] dbus_rdt_in[11]
  dbus_rdt_in[12] dbus_rdt_in[13] dbus_rdt_in[14] dbus_rdt_in[15]
  dbus_rdt_in[16] dbus_rdt_in[17] dbus_rdt_in[18] dbus_rdt_in[19]
  dbus_rdt_in[20] dbus_rdt_in[21] dbus_rdt_in[22] dbus_rdt_in[23]
  dbus_rdt_in[24] dbus_rdt_in[25] dbus_rdt_in[26] dbus_rdt_in[27]
  dbus_rdt_in[28] dbus_rdt_in[29] dbus_rdt_in[30] dbus_rdt_in[31]
  ext_rd_in[0] ext_rd_in[1] ext_rd_in[2] ext_rd_in[3]
  ext_rd_in[4] ext_rd_in[5] ext_rd_in[6] ext_rd_in[7]
  ext_rd_in[8] ext_rd_in[9] ext_rd_in[10] ext_rd_in[11]
  ext_rd_in[12] ext_rd_in[13] ext_rd_in[14] ext_rd_in[15]
  ext_rd_in[16] ext_rd_in[17] ext_rd_in[18] ext_rd_in[19]
  ext_rd_in[20] ext_rd_in[21] ext_rd_in[22] ext_rd_in[23]
  ext_rd_in[24] ext_rd_in[25] ext_rd_in[26] ext_rd_in[27]
  ext_rd_in[28] ext_rd_in[29] ext_rd_in[30] ext_rd_in[31]
}]

