      ]
    },
    "TaskExportDesign": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "urn:rocketeda:engine:v1#/$defs/Ref"
          },
          "minItems": 0
        },
        "settings": {
          "$ref": "urn:rocketeda:engine:v1#/$defs/Ref",
          "description": "Pinned saved settings asset; validated against the selected task and adapter schema. Native shell commands and argument vectors are forbidden."
        },
        "format": {
          "type": "string",
          "enum": [
            "gds",
            "oasis",
            "lef",
            "def",
            "magic",
            "xschem",
            "spice",
            "cdl",
            "verilog",
            "vhdl",
            "project_bundle"
          ]
        },
        "hierarchical": {
          "type": "boolean"
        },
        "include_sources": {
          "type": "boolean"
        }
      },
      "required": [
        "format"
      ]
    },
    "TaskCompileModel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "urn:rocketeda:engine:v1#/$defs/Ref"
          },
          "minItems": 0
        },
        "settings": {
          "$ref": "urn:rocketeda:engine:v1#/$defs/Ref",
          "description": "Pinned saved settings asset; validated against the selected task and adapter schema. Native shell commands and argument vectors are forbidden."
        },
        "source": {
          "$ref": "urn:rocketeda:engine:v1#/$defs/Ref"
        },
        "format": {
          "type": "string",
          "enum": [
            "osdi"
          ]
        },
        "model_name": {
          "type": "string",
          "minLength": 1,
          "description": ""
        }
      },
      "required": [
        "source",
        "format"
      ]
    }
  }
}
