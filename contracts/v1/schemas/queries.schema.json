{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rocketeda:engine:v1:schemas:queries",
  "title": "Engine v1 queries schemas",
  "$defs": {
    "Locator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "engine",
            "project",
            "pdk",
            "library",
            "package",
            "entity",
            "run",
            "artifact",
            "request",
            "workspace",
            "result",
            "dataset"
          ]
        },
        "id": {
          "$ref": "urn:rocketeda:engine:v1#/$defs/OpaqueId"
        },
        "project_id": {
          "$ref": "urn:rocketeda:engine:v1#/$defs/OpaqueId"
        },
        "revision": {
          "$ref": "urn:rocketeda:engine:v1#/$defs/Revision"
        },
        "profile": {
          "$ref": "urn:rocketeda:engine:v1#/$defs/Ref"
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "occurrence": {
          "type": "array",
          "items": {
            "$ref": "urn:rocketeda:engine:v1#/$defs/OpaqueId"
          }
        },
        "target": {
          "$ref": "urn:rocketeda:engine:v1#/$defs/Target"
        }
      },
      "required": [
        "kind"
      ],
      "description": "A bounded catalog/read source. Non-engine sources require id; PDK/library/package enumeration binds an immutable revision/profile in the response.",
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "not": {
                  "const": "engine"
                }
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "id"
            ]
          }
        }
      ]
    },
    "Filter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "operator": {
          "type": "string",
          "enum": [
            "eq",
            "ne",
            "in",
            "contains",
            "prefix",
            "lt",
            "le",
            "gt",
            "ge"
          ]
        },
        "value": {
          "oneOf": [
            {
              "$ref": "urn:rocketeda:engine:v1#/$defs/Scalar"
            },
            {
              "type": "array",
              "items": {
                "$ref": "urn:rocketeda:engine:v1#/$defs/Scalar"
              }
            }
          ]
        }
      },
      "required": [
        "field",
        "operator",
        "value"
      ],
      "description": "Fields/operators must be advertised by the selected catalog; executable predicates and arbitrary traversal are unsupported."
    },
    "QueryParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": {
          "$ref": "urn:rocketeda:engine:v1#/$defs/Locator"
        },
        "relation": {
          "type": "string",
          "enum": [
            "self",
            "components",
            "entities",
            "instances",
            "children",
            "descendants",
            "ancestors",
            "hierarchy",
            "dependencies",
            "ports",
            "pins",
            "nets",
            "symbols",
            "cells",
            "layers",
            "models",
            "sources",
            "scripts",
            "testbenches",
            "projects",
            "tools",
            "tasks",
            "capabilities",
            "runs",
            "findings",
            "artifacts",
            "logs",
            "content",
            "requests",
            "results",
            "datasets",
            "views",
            "chunks"
          ]
        },
        "filters": {
          "type": "array",
          "items": {
            "$ref": "urn:rocketeda:engine:v1#/$defs/Filter"
          }
        },
        "search": {
          "type": "string",
          "minLength": 1
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 100
        },
        "cursor": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "from",
        "relation"
      ]
    },
    "DescribeParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subject": {
          "type": "string",
          "enum": [
            "api",
            "method",
            "task",
            "tool",
            "entity_kind",
            "component_type",
            "schema",
            "template",
            "provider"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "$ref": "urn:rocketeda:engine:v1#/$defs/Target"
        },
        "profile": {
          "$ref": "urn:rocketeda:engine:v1#/$defs/Ref"
        },
        "search": {
          "type": "string",
          "minLength": 1
        },
        "cursor": {
          "type": "string",
          "minLength": 1
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 100
        }
      },
      "required": [],
      "description": "Omitted subject means api. Returns method/task schemas, descriptions, examples, effects, requirements and contextual availability without executing project code."
    },
    "CatalogItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ref": {
          "$ref": "urn:rocketeda:engine:v1#/$defs/PinnedRef"
        },
        "kind": {
          "type": "string",
          "enum": [
            "definition",
            "factory",
            "instance",
            "project",
            "pdk",
            "library",
            "package",
            "tool",
            "task",
            "template",
            "workspace",
            "request"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "schema_ref": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "urn:rocketeda:engine:v1#/$defs/Parameter"
          }
        },
        "ports": {
          "type": "array",
          "items": {
            "$ref": "urn:rocketeda:engine:v1#/$defs/CatalogPort"
          }
        },
        "views": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "availability": {
          "$ref": "urn:rocketeda:engine:v1#/$defs/Availability"
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "urn:rocketeda:engine:v1#/$defs/Ref"
          }
        },
        "port_templates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "domain",
              "width"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "domain": {
                "type": "string",
                "enum": [
                  "electrical",
                  "optical",
                  "thermal"
                ]
              },
              "width": {
                "$ref": "urn:rocketeda:engine:v1#/$defs/PortWidth"
              },
              "description": {
                "type": "string"
              }
            }
          }
        }
      },
      "required": [
        "ref",
        "kind",
        "name",
        "description",
        "availability"
      ],
      "description": "Catalog enumeration reports bounded descriptors and pinned provenance; never executes arbitrary module code or factories."
    },
    "Page": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "has_more": {
          "type": "boolean"
        },
        "snapshot": {
          "$ref": "urn:rocketeda:engine:v1#/$defs/PinnedRef"
        }
      },
      "required": [
        "cursor",
        "has_more"
      ],
      "description": "Snapshot-consistent stable ordering; cursor binds query/filter/provider/snapshot. Empty result has items:[], has_more:false, cursor:null."
    },
    "QueryItem": {
      "oneOf": [
        {
          "$ref": "urn:rocketeda:engine:v1#/$defs/EntityRecord"
        },
        {
          "$ref": "urn:rocketeda:engine:v1#/$defs/CatalogItem"
        },
        {
          "$ref": "urn:rocketeda:engine:v1#/$defs/RunRecord"
        },
        {
          "$ref": "urn:rocketeda:engine:v1#/$defs/Artifact"
        },
        {
          "$ref": "urn:rocketeda:engine:v1#/$defs/Finding"
        },
        {
          "$ref": "urn:rocketeda:engine:v1#/$defs/SourceContent"
        },
        {
          "$ref": "urn:rocketeda:engine:v1#/$defs/InputLock"
        },
        {
          "$ref": "urn:rocketeda:engine:v1#/$defs/Workspace"
        },
        {
          "$ref": "urn:rocketeda:engine:v1#/$defs/RequestRecord"
        },
        {
          "$ref": "urn:rocketeda:engine:v1#/$defs/ResultBundle"
        },
        {
          "$ref": "urn:rocketeda:engine:v1#/$defs/DatasetRecord"
        },
        {
          "$ref": "urn:rocketeda:engine:v1#/$defs/ChunkRef"
        },
        {
          "$ref": "urn:rocketeda:engine:v1#/$defs/TaskContract"
        },
        {
          "$ref": "urn:rocketeda:engine:v1#/$defs/LogDescriptor"
        }
      ]
    },
    "QueryResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "urn:rocketeda:engine:v1#/$defs/QueryItem"
          }
        },
        "page": {
          "$ref": "urn:rocketeda:engine:v1#/$defs/Page"
        }
      },
      "required": [
        "items",
        "page"
      ]
    },
    "MethodDescription": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "describe",
            "query",
            "edit",
            "run",
            "script",
            "watch"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "request_schema": {
          "type": "string",
          "minLength": 1
        },
        "result_schema": {
          "type": "string",
          "minLength": 1
        },
        "side_effects": {
          "type": "string",
          "enum": [
            "none",
            "design",
            "execution",
            "workspace"
          ]
        },
        "transport": {
          "$ref": "urn:rocketeda:engine:v1#/$defs/JsonValue"
        }
      },
      "required": [
        "name",
        "description",
        "request_schema",
        "result_schema",
        "side_effects"
      ]
    },
    "DescribeResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "1.0.0"
        },
        "contract_hash": {
          "$ref": "urn:rocketeda:engine:v1#/$defs/Hash"
        },
        "methods": {
          "type": "array",
          "items": {
            "$ref": "urn:rocketeda:engine:v1#/$defs/MethodDescription"
          }
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "urn:rocketeda:engine:v1#/$defs/CatalogItem"
          }
        },
        "schema": {
          "$ref": "urn:rocketeda:engine:v1#/$defs/JsonValue"
        },
        "page": {
          "$ref": "urn:rocketeda:engine:v1#/$defs/Page"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "urn:rocketeda:engine:v1#/$defs/CatalogItem"
          }
        }
      },
      "required": [
        "contract_version",
        "contract_hash",
        "methods",
        "items",
        "page"
      ],
      "description": "schema carries the exact requested canonical schema fragment; upstream package help is version-scoped and labeled separately."
    },
    "CatalogPort": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "urn:rocketeda:engine:v1#/$defs/OpaqueId"
        },
        "definition_port_id": {
          "$ref": "urn:rocketeda:engine:v1#/$defs/OpaqueId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "enum": [
            "electrical",
            "optical",
            "thermal"
          ]
        },
        "direction": {
          "type": "string",
          "enum": [
            "input",
            "output",
            "inout",
            "passive"
          ]
        },
        "width": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "state": {
          "type": "string",
          "enum": [
            "resolved",
            "unresolved",
            "stale"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "occurrence": {
          "type": "array",
          "items": {
            "$ref": "urn:rocketeda:engine:v1#/$defs/OpaqueId"
          }
        }
      },
      "required": [
        "id",
        "name",
        "domain",
        "direction",
        "width",
        "state"
      ],
      "description": "Catalog interface ports include stable canonical identity; unresolved width is null with reason, ready operations require elaboration.",
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "resolved"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "unresolved",
                  "stale"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        }
      ]
    }
  }
}
