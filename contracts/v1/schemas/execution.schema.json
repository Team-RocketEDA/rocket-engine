{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rocketeda:engine:v1:schemas:execution",
  "title": "Engine v1 execution schemas",
  "$defs": {
    "Target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "$ref": "urn:rocketeda:engine:v1#/$defs/OpaqueId"
        },
        "kind": {
          "type": "string",
          "enum": [
            "project",
            "component",
            "instance",
            "testbench",
            "selection"
          ]
        },
        "id": {
          "$ref": "urn:rocketeda:engine:v1#/$defs/OpaqueId"
        },
        "occurrence": {
          "type": "array",
          "items": {
            "$ref": "urn:rocketeda:engine:v1#/$defs/OpaqueId"
          }
        },
        "snapshot": {
          "$ref": "urn:rocketeda:engine:v1#/$defs/Revision"
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "urn:rocketeda:engine:v1#/$defs/OpaqueId"
          },
          "minItems": 1
        }
      },
      "required": [
        "project_id",
        "kind"
      ],
      "description": "Non-project targets require id; occurrence is a root-anchored array of instance IDs. Runs pin the resolved occurrence/dependency closure. A target id with repeated definition instances needs occurrence; never select an arbitrary first match.",
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "component",
                  "instance",
                  "testbench"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "selection"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "members"
            ]
          }
        }
      ]
    },
    "ViewSelection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "implementation": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "layout": {
          "type": "string",
          "minLength": 1
        },
        "testbench": {
          "$ref": "urn:rocketeda:engine:v1#/$defs/Ref"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "urn:rocketeda:engine:v1#/$defs/Ref"
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "urn:rocketeda:engine:v1#/$defs/Ref"
          }
        }
      },
      "required": [],
      "description": "Explicit named view selection. Missing values use a unique declared default; ambiguous selection is an error."
    },
    "RunStart": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "start"
        },
        "target": {
          "$ref": "urn:rocketeda:engine:v1#/$defs/Target"
        },
        "task": {
          "type": "string",
          "enum": [
            "workflow.asic",
            "workflow.analog",
            "workflow.photonic",
            "check.syntax",
            "check.connectivity",
            "check.erc",
            "check.drc",
            "check.lvs",
            "check.antenna",
            "check.view_sync",
            "check.layout_xor",
            "check.formal",
            "check.equivalence",
            "check.mutation",
            "simulate.spice",
            "simulate.hdl",
            "simulate.cosim",
            "simulate.optical",
            "synthesize.hdl",
            "implement.asic",
            "implement.fpga",
            "analyze.timing",
            "analyze.power",
            "analyze.measurements",
            "extract.layout",
            "characterize.circuit",
            "simulate.em",
            "simulate.thermal",
            "simulate.device",
            "generate.views",
            "generate.netlist",
            "export.design",
            "compile.model"
          ]
        },
        "options": {
          "type": "object"
        },
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "views": {
          "$ref": "urn:rocketeda:engine:v1#/$defs/ViewSelection"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "$ref": "urn:rocketeda:engine:v1#/$defs/OpaqueId"
          },
          "description": "Additional caller dependencies only; engine unions mandatory prerequisite DAG. Cannot weaken hard input or check gates."
        },
        "fresh": {
          "type": "boolean",
          "default": false
        },
        "override_failed_gates": {
          "type": "array",
          "items": {
            "$ref": "urn:rocketeda:engine:v1#/$defs/OpaqueId"
          }
        },
        "seeds": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "action",
        "target",
        "task",
        "options"
      ],
      "description": "options is constrained by task dispatch allOf below. Fresh bypasses in-flight coalescing, never request-id idempotency. Gate overrides require distinct trusted authorization; hard prerequisites are mandatory. All task outputs are run artifacts; adoption into project truth is explicit through edit. Managed scripts use their own commit checkpoints.",
      "oneOf": [
        {
          "properties": {
            "task": {
              "const": "workflow.asic"
            },
            "options": {
              "$ref": "urn:rocketeda:engine:v1#/$defs/TaskWorkflowAsic"
            },
            "tool": {
              "type": "string",
              "enum": [
                "librelane"
              ]
            },
            "target": {
              "properties": {
                "kind": {
                  "enum": [
                    "project",
                    "component",
                    "instance"
                  ]
                }
