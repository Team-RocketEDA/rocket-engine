    "RunControl": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "cancel",
            "resume",
            "discard"
          ]
        },
        "project_id": {
          "$ref": "urn:rocketeda:engine:v1#/$defs/OpaqueId"
        },
        "run_id": {
          "$ref": "urn:rocketeda:engine:v1#/$defs/OpaqueId"
        },
        "override_quarantine": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "action",
        "project_id",
        "run_id"
      ],
      "description": "Controls remain responsive under saturation. Resume applies only unfinished/interrupted runs; finished reruns are fresh starts.",
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "cancel",
                  "discard"
                ]
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "not": {
              "required": [
                "override_quarantine"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "override_quarantine": {
                "const": true
              }
            },
            "required": [
              "override_quarantine"
            ]
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        }
      ]
    },
    "RunParams": {
      "oneOf": [
        {
          "$ref": "urn:rocketeda:engine:v1#/$defs/RunStart"
        },
        {
          "$ref": "urn:rocketeda:engine:v1#/$defs/RunControl"
        }
      ]
    },
    "ScriptOpen": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "open"
        },
        "project_id": {
