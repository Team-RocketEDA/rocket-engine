    "RunReceipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "admitted": {
          "const": true
        },
        "run_id": {
          "$ref": "urn:rocketeda:engine:v1#/$defs/OpaqueId"
        },
        "project_id": {
          "$ref": "urn:rocketeda:engine:v1#/$defs/OpaqueId"
        },
        "snapshot": {
          "$ref": "urn:rocketeda:engine:v1#/$defs/Revision"
        },
        "state": {
          "type": "string",
          "enum": [
            "queued",
            "running"
          ]
        },
        "coalesced": {
          "type": "boolean"
        },
        "event_cursor": {
          "type": "string",
          "minLength": 1
        },
        "capacity": {
          "$ref": "urn:rocketeda:engine:v1#/$defs/Capacity"
        }
      },
      "required": [
        "admitted",
        "run_id",
        "project_id",
        "snapshot",
        "state",
        "coalesced",
        "event_cursor",
        "capacity"
      ],
      "description": "Durable acknowledgment; execution begins without a second start message. Every coalesced request ID persists. state records immutable admission state; query/watch provide current state, including an immediate completion."
    },
    "RunControlResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "$ref": "urn:rocketeda:engine:v1#/$defs/OpaqueId"
        },
        "project_id": {
          "$ref": "urn:rocketeda:engine:v1#/$defs/OpaqueId"
        },
        "action": {
          "type": "string",
          "enum": [
            "cancel",
            "resume",
            "discard"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "completed",
            "failed",
            "cancelled",
            "interrupted",
            "quarantined",
            "discarded",
            "skipped"
          ]
        },
        "event_cursor": {
          "type": "string",
          "minLength": 1
        },
        "cancel_requested": {
          "type": "boolean"
        }
      },
      "required": [
        "run_id",
        "project_id",
        "action",
        "state",
        "event_cursor",
        "cancel_requested"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "resume"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "properties": {
              "state": {
                "type": "string",
                "enum": [
                  "queued",
                  "running"
                ]
              },
              "cancel_requested": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "discard"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "properties": {
              "state": {
                "const": "discarded"
              },
              "cancel_requested": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "cancel"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "properties": {
              "cancel_requested": {
                "const": true
              }
            }
          }
        }
      ]
    },
