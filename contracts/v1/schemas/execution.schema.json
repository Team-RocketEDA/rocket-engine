          "$ref": "urn:rocketeda:engine:v1#/$defs/Ref"
        }
      },
      "required": [
        "action",
        "project_id",
        "profile"
      ],
      "description": "Creates workspace history/context, executes no user code."
    },
    "ScriptExecute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "execute"
        },
        "project_id": {
          "$ref": "urn:rocketeda:engine:v1#/$defs/OpaqueId"
        },
        "workspace_id": {
          "$ref": "urn:rocketeda:engine:v1#/$defs/OpaqueId"
        },
        "generation": {
          "type": "string",
          "minLength": 1
        },
        "snapshot": {
          "$ref": "urn:rocketeda:engine:v1#/$defs/Revision"
        },
        "history_cursor": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "urn:rocketeda:engine:v1#/$defs/Ref"
        }
      },
      "required": [
        "action",
        "project_id",
        "workspace_id",
        "generation",
        "snapshot",
        "history_cursor"
      ],
      "description": "Exactly one of code/source. Uses ordinary durable run admission, same execution isolation and I28; never coalesce mutating scripts. Earlier explicit edits survive later exceptions.",
      "oneOf": [
        {
          "required": [
            "code"
          ],
          "not": {
            "required": [
              "source"
            ]
          }
        },
        {
          "required": [
            "source"
          ],
          "not": {
            "required": [
              "code"
            ]
          }
        }
      ]
    },
