        "name",
        "kind",
        "status"
      ],
      "description": "One flat hierarchy node. Roots have no parent_id; nesting is by reference, never by document depth."
    },
    "TreeDataset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
