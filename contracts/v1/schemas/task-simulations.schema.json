              "$ref": "urn:rocketeda:engine:v1#/$defs/Quantity"
            }
          },
          "required": [
            "stop",
            "step"
          ]
        }
      },
      "required": [
        "analog",
        "digital",
        "coupling",
        "testbench"
      ]
    },
