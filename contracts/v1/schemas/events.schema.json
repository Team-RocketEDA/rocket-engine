{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rocketeda:engine:v1:schemas:events",
  "title": "Engine v1 events schemas",
  "$defs": {
    "WatchParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "$ref": "urn:rocketeda:engine:v1#/$defs/OpaqueId"
        },
        "after": {
          "type": [
            "string",
            "null"
          ]
        },
        "types": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "project.changed",
              "entity.changed",
              "run.state",
              "run.findings",
              "run.artifact",
              "script.output",
              "capacity.changed",
              "runtime.recovered",
              "testbench.stale",
              "run.result_ready",
              "run.log"
            ]
          },
          "uniqueItems": true
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 100
        },
        "wait_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30000,
          "default": 0
        }
      },
      "required": [
        "after"
      ],
      "description": "after:null establishes bootstrap snapshot/cursor atomically. Cursors are opaque, ordered per runtime stream and bound to filters/scope."
    },
    "Event_project_changed": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "const": "rocketeda/v1"
        },
        "id": {
          "$ref": "urn:rocketeda:engine:v1#/$defs/OpaqueId"
        },
        "cursor": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "project.changed"
        },
        "project_id": {
          "$ref": "urn:rocketeda:engine:v1#/$defs/OpaqueId"
        },
        "request_id": {
          "$ref": "urn:rocketeda:engine:v1#/$defs/OpaqueId"
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "time": {
          "type": "string",
          "format": "date-time"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "project_id": {
              "$ref": "urn:rocketeda:engine:v1#/$defs/OpaqueId"
            },
            "revision": {
              "$ref": "urn:rocketeda:engine:v1#/$defs/Revision"
            },
            "changes": {
              "type": "array",
              "items": {
                "$ref": "urn:rocketeda:engine:v1#/$defs/OpaqueId"
              }
            }
          },
          "required": [
            "project_id",
            "revision",
            "changes"
          ]
        }
      },
      "required": [
        "protocol",
        "id",
        "cursor",
        "type",
        "actor",
        "time",
        "data",
        "project_id",
        "request_id"
      ]
    },
    "Event_entity_changed": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "const": "rocketeda/v1"
        },
        "id": {
          "$ref": "urn:rocketeda:engine:v1#/$defs/OpaqueId"
        },
        "cursor": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "entity.changed"
        },
        "project_id": {
          "$ref": "urn:rocketeda:engine:v1#/$defs/OpaqueId"
        },
        "request_id": {
          "$ref": "urn:rocketeda:engine:v1#/$defs/OpaqueId"
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "time": {
          "type": "string",
          "format": "date-time"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "entity": {
              "$ref": "urn:rocketeda:engine:v1#/$defs/EntityRecord"
            }
          },
          "required": [
            "entity"
          ]
        }
      },
      "required": [
        "protocol",
        "id",
        "cursor",
        "type",
        "actor",
        "time",
        "data",
        "project_id",
        "request_id"
      ]
    },
    "Event_run_state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "const": "rocketeda/v1"
        },
        "id": {
          "$ref": "urn:rocketeda:engine:v1#/$defs/OpaqueId"
        },
        "cursor": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "run.state"
        },
        "project_id": {
          "$ref": "urn:rocketeda:engine:v1#/$defs/OpaqueId"
        },
        "request_id": {
          "$ref": "urn:rocketeda:engine:v1#/$defs/OpaqueId"
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "time": {
          "type": "string",
          "format": "date-time"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "run_id": {
              "$ref": "urn:rocketeda:engine:v1#/$defs/OpaqueId"
            },
            "state": {
              "type": "string",
              "enum": [
                "queued",
                "running",
                "completed",
                "failed",
                "cancelled",
                "interrupted",
                "quarantined",
                "discarded",
                "skipped"
              ]
            },
            "verdict": {
              "type": "string",
              "enum": [
                "PASS",
                "FAIL",
                "UNKNOWN",
                "NOT_RUN",
                "UNSUPPORTED",
                "NOT_APPLICABLE"
              ]
            }
          },
          "required": [
            "run_id",
            "state",
            "verdict"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "state": {
                    "const": "queued"
                  }
                },
                "required": [
                  "state"
                ]
              },
              "then": {
                "properties": {
                  "verdict": {
                    "const": "NOT_RUN"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "state": {
                    "const": "running"
                  }
                },
                "required": [
                  "state"
                ]
              },
              "then": {
                "properties": {
                  "verdict": {
                    "type": "string",
                    "enum": [
                      "UNKNOWN",
                      "NOT_RUN"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "state": {
                    "not": {
                      "const": "completed"
                    }
                  }
                },
                "required": [
                  "state"
                ]
              },
              "then": {
                "properties": {
                  "verdict": {
                    "not": {
                      "const": "PASS"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "required": [
        "protocol",
        "id",
        "cursor",
        "type",
        "actor",
        "time",
        "data",
        "project_id"
      ]
    },
