  {
    "name": "Create linked GDSFactory source and component atomically",
    "schema": "#/$defs/Request",
    "value": {
      "protocol": "rocketeda/v1",
      "request_id": "req-create-linked-gdsfactory-source-and-component-atomically",
      "method": "edit",
      "params": {
        "project_id": "chip",
        "preconditions": [],
        "changes": [
          {
            "op": "create",
            "key": "@source",
            "entity": {
              "kind": "source",
              "name": "filter.py",
              "path": "sources/filter.py",
              "format": "python",
              "role": "generator"
            }
          },
          {
            "op": "create",
            "key": "@filter",
            "entity": {
              "kind": "component",
              "name": "filter",
              "component_type": "gdsf_component",
              "domains": [
                "photonic"
              ],
              "ports": [],
              "models": {
                "spice": {
                  "state": "not_applicable",
                  "reason": "Pure optical layout; optical compact model is separate."
                }
              },
              "views": [
                {
                  "id": "layout-source",
                  "role": "layout_generator",
                  "format": "python",
                  "authority": "generator",
                  "sources": [
                    {
                      "local": "@source"
                    }
                  ],
                  "entry": "make_filter",
                  "profile": {
                    "scope": "engine",
                    "id": "design-profile",
                    "revision": "r1"
                  }
                }
              ]
            }
          }
        ]
      }
    }
  },
