            "conditions": {
              "type": "array",
              "items": {
                "$ref": "urn:rocketeda:engine:v1#/$defs/EditRef"
              }
            },
            "provenance": {
              "type": "string",
              "enum": [
                "authored",
                "pdk_reference",
                "mapped_netlist",
                "extracted"
              ]
            }
          },
          "required": [
            "state",
            "source",
            "dialect",
            "entry",
            "terminal_order",
            "port_map",
            "provenance"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "derivable"
            },
            "task": {
              "type": "string",
              "minLength": 1
            },
            "inputs": {
              "type": "array",
              "items": {
                "$ref": "urn:rocketeda:engine:v1#/$defs/EditRef"
              }
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "state",
            "task",
            "inputs",
            "reason"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "unavailable",
                "not_applicable"
              ]
