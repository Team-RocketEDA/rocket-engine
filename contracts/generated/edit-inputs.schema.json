    "EditComponentData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "component"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "component_type": {
          "type": "string",
          "enum": [
            "assembly",
            "primitive",
            "spice_block",
            "gdsf_component",
            "hdl_component"
          ]
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "analog",
              "digital",
              "photonic",
              "thermal"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "ports": {
          "type": "array",
          "items": {
            "$ref": "urn:rocketeda:engine:v1#/$defs/EditId"
          },
          "uniqueItems": true
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "urn:rocketeda:engine:v1#/$defs/Parameter"
          }
        },
        "models": {
          "$ref": "urn:rocketeda:engine:v1#/$defs/EditModels"
        },
        "views": {
          "type": "array",
          "items": {
            "$ref": "urn:rocketeda:engine:v1#/$defs/EditSourceView"
          }
        },
        "symbol": {
          "$ref": "urn:rocketeda:engine:v1#/$defs/EditRef"
        },
        "schematic": {
          "$ref": "urn:rocketeda:engine:v1#/$defs/EditRef"
        },
        "layout": {
          "$ref": "urn:rocketeda:engine:v1#/$defs/EditRef"
        },
        "pdk": {
          "$ref": "urn:rocketeda:engine:v1#/$defs/EditRef"
        },
        "hdl_language": {
          "type": "string",
          "enum": [
            "inherit"
          ]
        }
      },
      "required": [
        "kind",
        "name",
        "component_type",
        "domains",
        "ports",
        "models",
        "views"
      ],
      "description": "Creation presets share one component identity. Exactly one authoring owner per view; generator and manual layout are explicit variants, never competing writers.",
      "x-derived-from": "#/$defs/ComponentData"
    },
    "EditModels": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spice": {
          "$ref": "urn:rocketeda:engine:v1#/$defs/EditSpiceModel"
