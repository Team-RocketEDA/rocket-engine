            "dialect": {
              "type": "string",
              "enum": [
                "spice",
                "ngspice",
                "xyce",
                "cdl"
              ]
            },
            "entry": {
              "type": "string",
              "minLength": 1
            },
            "terminal_order": {
              "type": "array",
              "items": {
                "$ref": "urn:rocketeda:engine:v1#/$defs/EditId"
